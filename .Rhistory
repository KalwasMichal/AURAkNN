# ─────────────────────────────────────────────────────────────────────────────
#  Benchmark: AURAkNN (precise/gower, fast/gower)  vs  VIM::kNN
#  Dataset:   ggplot2::diamonds  (~54 000 rows, 7 columns used)
#  Metrics:   RMSE (numeric), Accuracy (categorical), Time (sec)
#
#  diamonds has a clear block-correlation structure:
#
#    Block A — physical dimensions (very strongly correlated, r ~ 0.97):
#      carat, x, y, z
#
#    Block B — quality grades (correlated with each other, less with Block A):
#      cut (factor, 5 levels), color (factor, 7 levels), clarity (factor, 8 levels)
#
#    Bridge column:
#      price — driven mostly by Block A (size), less by Block B (quality)
#
#  Why precise/gower should win here:
#    When imputing e.g. `carat`, the weight matrix gives x/y/z weight ~1.0
#    and cut/color/clarity much lower weight.  fast/gower gives all columns
#    equal weight, so quality grades dilute the strong physical signal.
#    The gap is largest for the physical-dimension columns.
#
#  Columns excluded: none (all 10 used as-is)
# ─────────────────────────────────────────────────────────────────────────────
library(AURAkNN)
library(VIM)
library(ggplot2)   # for diamonds
set.seed(2115)
# ── 1. Prepare ground truth ───────────────────────────────────────────────────
data(diamonds, package = "ggplot2")
# Keep all 10 columns; ensure factor types
diamonds_sub <- as.data.frame(diamonds)
diamonds_sub$cut     <- as.factor(diamonds_sub$cut)
diamonds_sub$color   <- as.factor(diamonds_sub$color)
diamonds_sub$clarity <- as.factor(diamonds_sub$clarity)
# Remove any pre-existing NAs (there are none in diamonds, but be safe)
diamonds_sub <- diamonds_sub[complete.cases(diamonds_sub), ]
# Sample 10 000 rows for a fair comparison with nycflights13 benchmark
diamonds_sub <- diamonds_sub[sample(nrow(diamonds_sub), 10000), ]
original <- diamonds_sub
cat("Dataset dimensions:", nrow(original), "x", ncol(original), "\n")
cat("Columns          :", paste(names(original), collapse = ", "), "\n\n")
# ── 2. Inject missing values (20 % per column) ───────────────────────────────
inject_na <- function(df, frac = 0.20, seed = 42) {
set.seed(seed)
out <- df
n   <- nrow(df)
for (col in names(df)) {
idx <- sample(n, size = floor(n * frac))
out[idx, col] <- NA
}
out
}
diamonds_na <- inject_na(original, frac = 0.20)
cat("Missing values per column after injection:\n")
print(colSums(is.na(diamonds_na)))
cat("\n")
# ── 3. Helper metrics ─────────────────────────────────────────────────────────
rmse <- function(true_df, imputed_df, na_df) {
num_cols <- names(true_df)[sapply(true_df, is.numeric)]
sapply(num_cols, function(col) {
na_idx <- is.na(na_df[[col]])
sqrt(mean((true_df[[col]][na_idx] -
as.numeric(imputed_df[[col]][na_idx]))^2))
})
}
cat_accuracy <- function(true_df, imputed_df, na_df) {
cat_cols <- names(true_df)[sapply(true_df, is.factor)]
sapply(cat_cols, function(col) {
na_idx <- is.na(na_df[[col]])
mean(as.character(true_df[[col]][na_idx]) ==
as.character(imputed_df[[col]][na_idx]))
})
}
# ── 4. Run AURAkNN — precise / gower ─────────────────────────────────────────
cat("Running AURAkNN precise/gower...\n")
time_aura_precise <- system.time({
imputed_aura_precise <- kNN_impute(
data    = diamonds_na,
k       = 10,
metric  = "gower",
mode    = "precise",
num_fun = "median",
threads = 4
)
})
cat("Done in", time_aura_precise["elapsed"], "s\n\n")
# ── 5. Run AURAkNN — fast / gower ────────────────────────────────────────────
cat("Running AURAkNN fast/gower...\n")
time_aura_fast <- system.time({
imputed_aura_fast <- kNN_impute(
data    = diamonds_na,
k       = 10,
metric  = "gower",
mode    = "fast",
num_fun = "median",
threads = 4
)
})
cat("Done in", time_aura_fast["elapsed"], "s\n\n")
# ── 6. Run VIM::kNN ───────────────────────────────────────────────────────────
cat("Running VIM::kNN (this may take a while)...\n")
#time_vim <- system.time({
#  imputed_vim <- VIM::kNN(
#   data    = diamonds_na,
#  k       = 10,
#    numFun  = median,
#    catFun  = VIM::maxCat,
#    imp_var = FALSE
#  )
#})
#cat("Done in", time_vim["elapsed"], "s\n\n")
# ── 7. Compute metrics ────────────────────────────────────────────────────────
rmse_precise <- rmse(original, imputed_aura_precise, diamonds_na)
rmse_fast    <- rmse(original, imputed_aura_fast,    diamonds_na)
#rmse_vim     <- rmse(original, imputed_vim,          diamonds_na)
acc_precise  <- cat_accuracy(original, imputed_aura_precise, diamonds_na)
acc_fast     <- cat_accuracy(original, imputed_aura_fast,    diamonds_na)
#acc_vim      <- cat_accuracy(original, imputed_vim,          diamonds_na)
# ── 8. Print results tables ───────────────────────────────────────────────────
cat("\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
cat("  RMSE per numeric column\n")
cat("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
rmse_table <- data.frame(
Column                  = names(rmse_precise),
`AURAkNN precise/gower` = round(rmse_precise, 4),
`AURAkNN fast/gower`    = round(rmse_fast,    4),
#`VIM::kNN`              = round(rmse_vim,     4),
check.names = FALSE
)
print(rmse_table, row.names = FALSE)
cat("\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
cat("  Categorical Accuracy\n")
cat("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
acc_table <- data.frame(
Column                  = names(acc_precise),
`AURAkNN precise/gower` = round(acc_precise, 4),
`AURAkNN fast/gower`    = round(acc_fast,    4),
# `VIM::kNN`              = round(acc_vim,     4),
check.names = FALSE
)
print(acc_table, row.names = FALSE)
cat("\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
cat("  Execution Time (seconds)\n")
cat("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n")
time_table <- data.frame(
Package  = c("AURAkNN precise/gower", "AURAkNN fast/gower"),
Elapsed  = c(
round(time_aura_precise["elapsed"], 3),
round(time_aura_fast["elapsed"],    3),
# round(time_vim["elapsed"],          3)
)
)
